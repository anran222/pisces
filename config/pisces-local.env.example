# Pisces local runtime environment template.
#
# The local finalizer creates config/pisces-local.env from this template when
# missing. After it stops with NEEDS_QIANWEN_API_KEY, replace TONGYI_API_KEY
# and rerun the same finalizer command. Only change MySQL values if you
# intentionally use an existing local database instead of the project Docker
# stack:
#
#   scripts/production-infrastructure-local-finalize.sh
#
# Local infrastructure scripts load config/pisces-local.env and
# config/pisces-local-stack.env automatically. The stack env also carries the
# local Redis Docker container used by the finalize script for automatic
# docker-stop fault drills.
#
# Never commit config/pisces-local.env. It is ignored by .gitignore.

export MYSQL_URL="jdbc:mysql://localhost:3306/pisces?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai"
export MYSQL_USERNAME="root"
export MYSQL_PASSWORD=""

# Replace this one value with your local Qianwen/DashScope API key.
export TONGYI_API_KEY="<local-qianwen-api-key>"

# Default text model strategy for local AI smoke. Keep these defaults so the
# flow works with a standard Qianwen/DashScope API key after replacing only
# TONGYI_API_KEY. If your account has Token Plan preview access, you may
# explicitly override TONGYI_MODEL to qwen3.8-max-preview and TONGYI_API_MODE
# to openai-compatible.
export TONGYI_MODEL="qwen3.7-max"
export TONGYI_API_MODE="dashscope"
export TONGYI_BASE_URL="https://dashscope.aliyuncs.com/api/v1"
export TONGYI_FALLBACK_MODEL="qwen3.7-max"
export TONGYI_FALLBACK_API_MODE="dashscope"
export TONGYI_FALLBACK_BASE_URL="https://dashscope.aliyuncs.com/api/v1"
export TONGYI_MODEL_FALLBACK_ENABLED="true"
export TONGYI_ENABLE_THINKING="true"

# Local scoped API keys. Keep these placeholder values for local-only runs or
# replace them with non-production local keys.
export PISCES_API_KEY_SPECS="runtime-key|shop-app|sdk|runtime,ops-key|shop-app|ops|management+analysis,admin-key|platform|admin|admin"

export PISCES_CONFIG_CHANGE_REDIS_BROADCAST_ENABLED="true"
export PISCES_CONFIG_CHANGE_REDIS_CHANNEL="pisces:config-change:local"
export PISCES_EVENT_REPLAY_BATCH_SIZE="1000"
export PISCES_EVENT_REPLAY_MAX_FILTERED_COPY_FACTS="50000"

# Core screenshots generated from ../pisces-web.
export PISCES_COMPLETION_SCREENSHOT_DIR="../pisces-web/target/screenshots/core-functions-current"
